<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="SignUp"
        xmlns:vm="using:Password_Manager.ViewModels"
        x:Class="Password_Manager.Views.SignUpWindow"
        x:DataType="vm:SignUpWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SignUpWindow"
        Background="Black"
        Foreground="White"
        Height="200"
        Width="400"
        CanResize="False"
        RequestedThemeVariant="Dark">
    <Grid ColumnDefinitions="*" RowDefinitions="*, 3*, *">
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="30" Text="Регистрация"/>
        <Grid ColumnDefinitions="*, *" RowDefinitions="*, *, *" Grid.Row="1">
            <TextBlock Grid.Column="0" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Введите логин пользователя: "/>
            <TextBox Grid.Column="1" Text="{Binding PlainLogin}" Grid.Row="0" Watermark="логин" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="1" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Введите мастер-пароль: "/>
            <TextBox Grid.Column="1" Text="{Binding PlainPassword1}" Grid.Row="1" Watermark="мастер-пароль" PasswordChar="*" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="2" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Повторите мастер-пароль: "/>
            <TextBox Grid.Column="1" Text="{Binding PlainPassword2}" Grid.Row="2" Watermark="мастер-пароль" PasswordChar="*" Width="150"/>
        </Grid>
        <Button Grid.Row ="2" Margin="10, 0, 0, 0" Width="165" Content="Зарегистрироваться" 
                Command="{Binding Registration}" ToolTip.Tip="{Binding RegistrationHint}" ToolTip.ShowOnDisabled="True"/>
    </Grid>
</Window>
