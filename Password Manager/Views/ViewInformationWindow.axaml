<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Password_Manager.ViewModels"
        x:Class="Password_Manager.Views.ViewInformationWindow"
        x:DataType="vm:ViewInformationWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ViewInformationWindow"
        Background="Black"
        Foreground="White"
        Height="240"
        Width="560"
        CanResize="False"
        RequestedThemeVariant="Dark">
    <Grid ColumnDefinitions="*" RowDefinitions="*, 5*">
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="30" Text="Просмотр"/>
        <Grid ColumnDefinitions="*, *" RowDefinitions="*, *, *, *" Grid.Row="1">
            <TextBlock Grid.Column="0" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Сервис: "/>
            <TextBox Grid.Column="1" Text="{Binding ServiceName}" Grid.Row="0" IsReadOnly="True" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="1" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Логин: "/>
            <TextBox Grid.Column="1" Text="{Binding Login}" Grid.Row="1" IsReadOnly="True" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="2" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Пароль: "/>
            <TextBox Grid.Column="1" Text="{Binding Password}" Grid.Row="2" IsReadOnly="True" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="3" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Заметка к паролю: "/>
            <TextBox Grid.Column="1" Text="{Binding Note}" Grid.Row="3" IsReadOnly="True" Width="150"/>
        </Grid>
    </Grid>
</Window>
