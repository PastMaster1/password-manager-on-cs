<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Confirmation"
        xmlns:vm="using:Password_Manager.ViewModels"
        x:Class="Password_Manager.Views.ConfirmationWindow"
        x:DataType="vm:ConfirmationWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ConfirmationWindow"
        Background="Black"
        Foreground="White"
        Height="100"
        Width="250"
        CanResize="False"
        RequestedThemeVariant="Dark">
    <Grid ColumnDefinitions="*" RowDefinitions="*, *, *">
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="20" Text="Введите мастер-пароль" Margin="5,0,5,0"/>
        <TextBox Text="{Binding PlainPassword}" Grid.Row="1" Watermark="мастер-пароль" PasswordChar="*" Width="220" HorizontalAlignment="Center"/>
        <Button Grid.Row ="2" Margin="10, 0, 0, 0" Width="200" Content="Подтвердить действие" Command="{Binding Confirm}"
                ToolTip.Tip="{Binding ConfirmationHint}" ToolTip.ShowOnDisabled="True"/>   
    </Grid>
</Window>
