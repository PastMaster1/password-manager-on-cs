<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Addition"
        xmlns:vm="using:Password_Manager.ViewModels"
        x:Class="Password_Manager.Views.AdditionWindow"
        x:DataType="vm:AdditionWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AdditionWindow"
        Background="Black"
        Foreground="White"
        Height="320"
        Width="560"
        CanResize="False"
        RequestedThemeVariant="Dark">
    <Grid ColumnDefinitions="*" RowDefinitions="*, 5*, *, *">
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="30" Text="Добавление"/>
        <Grid ColumnDefinitions="*, *" RowDefinitions="*, *, *, *" Grid.Row="1">
            <TextBlock Grid.Column="0" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Введите название сервиса: "/>
            <TextBox Grid.Column="1" Text="{Binding ServiceName}" Grid.Row="0" Watermark="сервис" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="1" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Введите логин: "/>
            <TextBox Grid.Column="1" Text="{Binding Login}" Grid.Row="1" Watermark="логин" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="2" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Введите пароль: "/>
            <TextBox Grid.Column="1" Text="{Binding Password}" Grid.Row="2" Watermark="пароль" PasswordChar="*" Width="150"/>
            <TextBlock Grid.Column="0" Grid.Row="3" Margin="10, 0, 0, 0" VerticalAlignment="Center" Text="Введите заметку к паролю: "/>
            <TextBox Grid.Column="1" Text="{Binding Note}" Grid.Row="3" Watermark="заметка" Width="150"/>
        </Grid>
        <Button Grid.Row ="2" Margin="10, 0, 0, 0" Width="150" Content="Сохранить" Command="{Binding Add}"/>
        <Button Grid.Row ="3" Margin="10, 0, 0, 0" Width="175" Content="Сгенерировать пароль" Command="{Binding Generate}"/>
    </Grid>
</Window>
